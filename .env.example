DATABASE_URL=postgresql://steward:steward@postgres:5432/steward
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-me-with-a-long-random-string
# Optional. Empty derives a key from SECRET_KEY. Changing it invalidates saved IMAP passwords.
FERNET_KEY=

DEMO_USER_EMAIL=you@local
DEMO_USER_PASSWORD=steward

APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# Gmail App Passwords are pasted in Settings, not here.

# Optional Gmail API OAuth (unverified local client; add yourself as a test user).
# Register redirect URI: http://localhost:8000/accounts/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTHLIB_INSECURE_TRANSPORT=1

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

SYNC_INTERVAL_SEC=45
